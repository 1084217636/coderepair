# CodeRepair 配置文件示例
# 复制此文件为 .env 并填入您的实际配置值
# 不要在 .env.example 中保存真实密钥

# ==================== LLM 提供商选择 ====================
# 支持的提供商: openai, groq, ollama, aicanapi
# 默认: groq
LLM_PROVIDER=groq

# ==================== OpenAI 配置 ====================
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ==================== Groq 配置 ====================
# 从 https://console.groq.com/keys 获取（免费，速度很快！）
# 推荐配置示例（快速且免费）：
#   LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_your-groq-api-key-here
#   GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ==================== Ollama 配置 ====================
# 本地运行 Ollama 模型（无需 API Key）
# 本地测试配置：
#   LLM_PROVIDER=ollama
#   OLLAMA_API_BASE=http://localhost:11434/v1
#   OLLAMA_MODEL=llama2
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama2

# ==================== AiCanAPI 配置 ====================
# 从 https://aicanapi.com 获取
# 支持 Claude 模型（claude-opus-4-6, claude-sonnet-4-6）
# 推荐配置示例：
#   LLM_PROVIDER=aicanapi
#   AICANAPI_API_KEY=sk_your-aicanapi-key-here
#   AICANAPI_MODEL=claude-opus-4-6
AICANAPI_API_KEY=sk_your-aicanapi-key-here
AICANAPI_API_BASE=https://aicanapi.com/v1
AICANAPI_MODEL=claude-opus-4-6

# ==================== 通用 LLM 配置 ====================
# 温度参数 (0.0-2.0)，越高越有创意，越低越确定
LLM_TEMPERATURE=0.7
# HTTP 调用超时时间（秒）
LLM_TIMEOUT=90
# 连接超时（秒）
LLM_CONNECT_TIMEOUT=10
# 读取超时（秒）
LLM_READ_TIMEOUT=90
# 网络层额外重试次数
LLM_RETRY_ATTEMPTS=1
# 是否允许失败后回退到 mock
LLM_ALLOW_MOCK=true

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
DEBUG=false

# ==================== 检索配置 ====================
# 检索返回的最相关代码片段数
RETRIEVAL_TOP_K=5
RAG_BACKEND=hybrid
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=embeddinggemma
VECTOR_EMBEDDING_DIM=384

# ==================== 验证超时时间（秒）====================
VALIDATION_TIMEOUT=30

# ==================== 快速开始 ====================
# 
# 方案 1：使用 OpenAI (推荐商用)
#   步骤：
#   1. 获取 API Key: https://platform.openai.com/api-keys
#   2. 配置：
#      LLM_PROVIDER=openai
#      OPENAI_API_KEY=sk_xxxxx
#      OPENAI_MODEL=gpt-4
#
# 方案 2：使用 Groq (推荐快速测试，免费)
#   步骤：
#   1. 获取 API Key: https://console.groq.com/keys
#   2. 配置：
#      LLM_PROVIDER=groq
#      GROQ_API_KEY=gsk_xxxxx
#      GROQ_MODEL=mixtral-8x7b-32768
#
# 方案 3：使用 Ollama (本地运行，无需 API Key)
#   步骤：
#   1. 安装 Ollama: https://ollama.ai
#   2. 启动服务: ollama serve
#   3. 配置：
#      LLM_PROVIDER=ollama
#      OLLAMA_API_BASE=http://localhost:11434/v1
#
# 方案 4：使用 AiCanAPI (Claude 模型)
#   步骤：
#   1. 获取 API Key: https://aicanapi.com
#   2. 配置：
#      LLM_PROVIDER=aicanapi
#      AICANAPI_API_KEY=sk_xxxxx
#      AICANAPI_MODEL=claude-opus-4-6  # 或 claude-sonnet-4-6
#
# 方案 5：使用模拟模式（开发测试）
#   不配置任何 API Key，系统会使用内置的模拟回复

# ==================== 项目路径 ====================
# 可选：自定义工作区（默认使用 --workspace 参数指定）
# WORKSPACE_ROOT=/path/to/your/project
